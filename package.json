{
  "name": "forge",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @forge/web dev",
    "build": "pnpm --filter @forge/web build",
    "tokens": "node scripts/build-tokens.mjs",
    "lint": "pnpm --filter @forge/web lint",
    "typecheck": "pnpm --filter @forge/web typecheck",
    "db:generate": "pnpm --filter @forge/db generate",
    "db:migrate": "pnpm --filter @forge/db migrate",
    "db:push": "pnpm --filter @forge/db push",
    "db:studio": "pnpm --filter @forge/db studio"
  },
  "packageManager": "pnpm@9.0.0"
}
