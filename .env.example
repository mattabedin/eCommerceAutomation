# ============================================================
# Forge — AI Store Builder
# Environment variables
#
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets.
# ============================================================

# --- Database (Neon Postgres recommended) ---
# Pooled connection string from https://neon.tech → your project → Connection Details.
# Looks like: postgres://user:pass@ep-xxxx-pooler.region.aws.neon.tech/db?sslmode=require
DATABASE_URL=

# --- Auth.js v5 ---
# A 32-byte random base64 string. Generate with:  openssl rand -base64 32
AUTH_SECRET=
# Public URL of the deployed app. Used to build callback URLs.
# Local dev:    http://localhost:3000
# Production:   https://forge-ochre-nine.vercel.app
NEXTAUTH_URL=

# --- OAuth: Google ---
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web)
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://forge-ochre-nine.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- OAuth: Microsoft (Microsoft Entra ID — formerly Azure AD) ---
# Azure portal → Microsoft Entra ID → App registrations → New registration.
# Supported account types: "Personal Microsoft accounts only" or
# "Accounts in any organizational directory and personal Microsoft accounts".
# Web platform Redirect URIs:
#   http://localhost:3000/api/auth/callback/microsoft-entra-id
#   https://forge-ochre-nine.vercel.app/api/auth/callback/microsoft-entra-id
# Generate a client secret under "Certificates & secrets".
# Issuer defaults to "common" (any account type). Override only if you want
# to restrict to a specific tenant.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0

# --- Anthropic (AI Builder, Phase 2+) ---
ANTHROPIC_API_KEY=

# --- Stripe (Storefront checkout, Phase 5+) ---
# Test keys: https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY: sk_test_...
# STRIPE_PUBLISHABLE_KEY: pk_test_... (reserved for client-side Stripe Elements;
#   Forge uses the hosted Stripe Checkout flow today, so this is currently unused.)
# STRIPE_WEBHOOK_SECRET: whsec_... — created when you add an endpoint at
#   https://dashboard.stripe.com/test/webhooks pointing at
#   <NEXT_PUBLIC_APP_URL>/api/webhooks/stripe
#   Subscribe at minimum to: checkout.session.completed
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Cloudflare R2 (Storage / CDN, Phase 5+) ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ACCOUNT_ID=
R2_PUBLIC_URL=

# --- App ---
# Public origin used to build Stripe success/cancel URLs and other absolute
# links. On Vercel preview deploys you can leave this blank — the code falls
# back to https://$VERCEL_URL when this is missing.
NEXT_PUBLIC_APP_URL=http://localhost:3000
